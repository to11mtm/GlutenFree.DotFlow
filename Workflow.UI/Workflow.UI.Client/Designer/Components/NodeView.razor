@namespace Workflow.UI.Client.Designer.Components
@using Workflow.UI.Client.Designer.State
@using Workflow.UI.Client.Api.Dtos

<div class="df-node @StateClass @RoleClass @IssueClass @(Selected ? "df-node--selected" : "")"
     style="left:@(Node.X.ToString(Inv))px; top:@(Node.Y.ToString(Inv))px; width:@(CanvasGeometry.NodeWidth.ToString(Inv))px;"
     data-node-id="@Node.Id"
     @onpointerdown="OnPointerDown" @onpointerdown:stopPropagation="true"
     @oncontextmenu="OnContextMenu" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
    @if (Role is { IsIsolated: false } role && (role.IsStart || role.IsEnd))
    {
        <div class="df-node__rolebadges">
            @if (role.IsStart)
            {
                <span class="df-badge df-badge--start @(role.StartCount > 1 ? "df-badge--plural" : "")"
                      title="@(role.StartCount > 1 ? $"One of {role.StartCount} starting points — they all run, in parallel" : "The workflow begins here (no incoming connections)")">▶ @BadgeText("Start", role.StartIndex, role.StartCount)</span>
            }
            @if (role.IsEnd)
            {
                <span class="df-badge df-badge--end @(role.EndCount > 1 ? "df-badge--plural" : "")"
                      title="@(role.EndCount > 1 ? $"One of {role.EndCount} end points — each contributes to the workflow's result" : "The workflow ends here (no outgoing connections) — its outputs become the result")">⏹ @BadgeText("End", role.EndIndex, role.EndCount)</span>
            }
        </div>
    }
    <div class="df-node__header" style="height:@(CanvasGeometry.HeaderHeight.ToString(Inv))px;">
        <span class="df-node__icon">@Icon</span>
        <span class="df-node__titles">
            <span class="df-node__name" title="@Node.Name">@Node.Name</span>
            <span class="df-node__module" title="@Node.ModuleId">@Node.ModuleId</span>
        </span>
        @if (IssueTitle is not null)
        {
            <span class="df-node__issue df-node__issue--@IssueSeverityClass" title="@IssueTitle">⚠</span>
        }
        @if (!Node.IsModuleKnown)
        {
            <span class="df-node__warn" title="unknown module">⚠</span>
        }
        @if (StreamGraph.IsUnorderedStage(Node))
        {
            <span class="df-node__badge df-node__badge--unordered" data-testid="node-unordered"
                  title="This stage runs items concurrently with ordering turned off, so downstream items arrive in completion order. Keeping order costs nothing — turn it back on unless you need the throughput.">⚠ unordered</span>
        }
    </div>

    <div class="df-node__ports">
        <div class="df-node__col df-node__col--in">
            @foreach (var port in Inputs)
            {
                <div class="df-port df-port--in @(IsStreamingPort(port, false) ? "df-port--stream" : "") @(InputCompatible?.Invoke(port) == true ? "df-port--compatible" : "") @(InputEndpoint?.Invoke(port) == true ? "df-port--endpoint" : "")"
                     style="height:@(CanvasGeometry.PortRowHeight.ToString(Inv))px;"
                     data-port-in="@port"
                     data-port-streaming="@(IsStreamingPort(port, false) ? "true" : null)"
                     title="@PortTitle(port, isOutput: false)"
                     @onpointerup="() => OnInputPointerUp(port)" @onpointerup:stopPropagation="true">
                    <span class="df-port__dot" data-port-anchor="in:@port"></span>
                    <span class="df-port__label">@port</span>
                </div>
            }
        </div>
        <div class="df-node__col df-node__col--out">
            @foreach (var port in Outputs)
            {
                <div class="df-port df-port--out @(IsStreamingPort(port, true) ? "df-port--stream" : "") @(port == ActiveSourcePort ? "df-port--source" : "") @(OutputEndpoint?.Invoke(port) == true ? "df-port--endpoint" : "")"
                     style="height:@(CanvasGeometry.PortRowHeight.ToString(Inv))px;"
                     data-port-out="@port"
                     data-port-streaming="@(IsStreamingPort(port, true) ? "true" : null)"
                     title="@PortTitle(port, isOutput: true)"
                     @onpointerdown="() => OnOutputPointerDown(port)" @onpointerdown:stopPropagation="true">
                    <span class="df-port__label">@port</span>
                    <span class="df-port__dot" data-port-anchor="out:@port"></span>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    /// <summary>The node to render.</summary>
    [Parameter, EditorRequired]
    public DesignerNode Node { get; set; } = default!;

    /// <summary>Extra CSS state class (run overlay: running/completed/failed…).</summary>
    [Parameter]
    public string StateClass { get; set; } = string.Empty;

    /// <summary>Whether the node is selected.</summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>Raised on node pointer-down (selection / move-start in editing slices).</summary>
    [Parameter]
    public EventCallback<PointerEventArgs> OnNodePointerDown { get; set; }

    /// <summary>Raised on output-port pointer-down (connection-drag start in 3.3.b.2).</summary>
    [Parameter]
    public EventCallback<string> OnOutputPortPointerDown { get; set; }

    /// <summary>Raised on node right-click (context menu).</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnNodeContextMenu { get; set; }

    /// <summary>Raised on input-port pointer-up (connection-drop target in 3.3.b.2).</summary>
    [Parameter]
    public EventCallback<string> OnInputPortPointerUp { get; set; }

    /// <summary>Returns whether an input port is a compatible drop target during a connection drag.</summary>
    [Parameter]
    public Func<string, bool>? InputCompatible { get; set; }

    /// <summary>The output port a connection drag started from (highlighted), or null.</summary>
    [Parameter]
    public string? ActiveSourcePort { get; set; }

    /// <summary>Returns whether an input port is an endpoint of a selected connection.</summary>
    [Parameter]
    public Func<string, bool>? InputEndpoint { get; set; }

    /// <summary>Returns whether an output port is an endpoint of a selected connection.</summary>
    [Parameter]
    public Func<string, bool>? OutputEndpoint { get; set; }

    /// <summary>The node's derived start/end role (null hides the role affordances)~ 🧭.</summary>
    [Parameter]
    public GraphTopology.NodeRole? Role { get; set; }

    /// <summary>Module-declared icon (from the module catalog); falls back to the built-in table when null~ 🎨.</summary>
    [Parameter]
    public string? IconOverride { get; set; }

    /// <summary>Tooltip text for validation issues pointing at this node (null when clean)~ 📍.</summary>
    [Parameter]
    public string? IssueTitle { get; set; }

    /// <summary>The worst issue severity for this node: <c>error</c>, <c>warning</c>, or empty~ 📍.</summary>
    [Parameter]
    public string IssueSeverityClass { get; set; } = string.Empty;

    private IReadOnlyList<string> Inputs => NodePorts.Inputs(Node);

    private IReadOnlyList<string> Outputs => NodePorts.Outputs(Node);

    private string RoleClass => Role switch
    {
        null => string.Empty,
        { IsIsolated: true } => "df-node--unwired",
        { IsStart: true, StartCount: > 1 } => "df-node--role-start df-node--role-ambiguous",
        { IsStart: true } => "df-node--role-start",
        { IsEnd: true, EndCount: > 1 } => "df-node--role-end df-node--role-ambiguous",
        { IsEnd: true } => "df-node--role-end",
        _ => string.Empty,
    };

    private string IssueClass => string.IsNullOrEmpty(IssueSeverityClass) ? string.Empty : $"df-node--issue-{IssueSeverityClass}";

    private static string BadgeText(string label, int index, int count)
        => count > 1 ? $"{label} {index + 1} of {count}" : label;

    /// <summary>Port tooltip from the schema's port description (K2) — null keeps the attribute off~ 🔌.</summary>
    private string? PortTitle(string port, bool isOutput)
    {
        var ports = isOutput ? Node.Schema?.Outputs : Node.Schema?.Inputs;
        var description = ports?.FirstOrDefault(p => p.Name == port)?.Description;
        var streaming = IsStreamingPort(port, isOutput);

        // 🌊 A diamond port is a different *kind* of connection, so say so — the shape alone
        // doesn't teach anyone the rule the first time they meet it~
        var streamNote = streaming ? "🌊 Streaming port — connects only to other streaming ports" : null;

        return (string.IsNullOrWhiteSpace(description), streamNote) switch
        {
            (true, null) => null,
            (true, _) => streamNote,
            (false, null) => description,
            _ => $"{description} · {streamNote}",
        };
    }

    /// <summary>Whether a port carries a stream (drives the diamond glyph)~ 🌊.</summary>
    private bool IsStreamingPort(string port, bool isOutput)
        => StreamGraph.IsStreamingPort(Node, port, isOutput);

    private string Icon => !string.IsNullOrWhiteSpace(IconOverride) ? IconOverride! : Node.ModuleId switch
    {
        "builtin.start" => "🚀",
        "builtin.end" => "🏁",
        var m when m.Contains("trycatch") => "🛡️",
        var m when m.Contains("loop") => "🔁",
        var m when m.Contains("http") => "🌐",
        var m when m.Contains("script") => "📜",
        var m when m.Contains("condition") || m.Contains("switch") => "◇",
        var m when m.Contains("log") => "📝",
        var m when m.Contains("database") => "🗄️",
        var m when m.Contains("file") || m.Contains("csv") => "📄",
        var m when m.Contains("transform") => "🔄",
        _ => "⚙️",
    };

    private Task OnPointerDown(PointerEventArgs e) => OnNodePointerDown.InvokeAsync(e);

    private Task OnContextMenu(MouseEventArgs e) => OnNodeContextMenu.InvokeAsync(e);

    private Task OnOutputPointerDown(string port) => OnOutputPortPointerDown.InvokeAsync(port);

    private Task OnInputPointerUp(string port) => OnInputPortPointerUp.InvokeAsync(port);
}
