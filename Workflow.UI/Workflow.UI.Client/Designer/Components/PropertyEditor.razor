@namespace Workflow.UI.Client.Designer.Components
@using System.Linq
@using System.Text.Json
@using Workflow.UI.Client.Api.Dtos
@using Workflow.UI.Client.Designer.State

@* ⚙️ Phase 3.3.b.3 — Renders the correct control for a property's EditorType (D6). *@
<div class="df-field" data-prop="@Property.Name">
    <label class="df-label" title="@Tooltip">
        @Property.DisplayName
        @if (Property.IsRequired)
        {
            <span class="df-required">*</span>
        }
        @if (!string.IsNullOrWhiteSpace(Property.Description))
        {
            <span class="df-label__info" data-testid="info-@Property.Name" title="@Tooltip">ⓘ</span>
        }
    </label>

    @* Tall editors get a visible helper line — hover tooltips are awkward there (G3/Q3). *@
    @if (!string.IsNullOrWhiteSpace(Property.Description) && Property.EditorType is "MultilineText" or "Json" or "Code")
    {
        <div class="df-field-help" data-testid="help-@Property.Name">@Property.Description</div>
    }

    @switch (Property.EditorType)
    {
        case "Boolean":
            <label><input type="checkbox" checked="@JsonValues.AsBool(Value)" @onchange="OnBoolChange" data-testid="editor-@Property.Name" /> @Property.DisplayName</label>
            break;

        case "Number":
            <input class="df-input" type="number" value="@JsonValues.ToText(Value)" @oninput="OnNumberInput" data-testid="editor-@Property.Name" />
            break;

        case "Dropdown" when AllowedOptions.Count > 0:
            <select class="df-input" @onchange="OnStringChange" data-testid="editor-@Property.Name">
                @if (!Property.IsRequired)
                {
                    <option value="" selected="@(string.IsNullOrEmpty(JsonValues.ToText(Value)))">(auto)</option>
                }
                @foreach (var option in AllowedOptions)
                {
                    <option value="@option" selected="@(option == JsonValues.ToText(Value))">@option</option>
                }
            </select>
            break;

        case "Dropdown":
            @* No AllowedValues declared (e.g. a third-party module) — fall back to free text. *@
            <input class="df-input" value="@JsonValues.ToText(Value)" @oninput="OnStringInput" data-testid="editor-@Property.Name" />
            break;

        case "MultilineText":
            <textarea class="df-textarea" value="@JsonValues.ToText(Value)" @oninput="OnStringInput" data-testid="editor-@Property.Name"></textarea>
            break;

        case "Expression":
            <input class="df-input df-input--mono" value="@JsonValues.ToText(Value)" placeholder="{{ expression }}" @oninput="OnStringInput" data-testid="editor-@Property.Name" />
            break;

        case "Json":
            <CodeEditor Value="@JsonText" Language="json" ValueChanged="OnJsonEditorChange" />
            @if (jsonInvalid)
            {
                <div class="df-field-error">⚠ invalid JSON</div>
            }
            break;

        case "Code":
            <CodeEditor Value="@JsonValues.ToText(Value)" Language="@CodeLanguage" ValueChanged="OnStringChangeText" />
            break;

        default: // Text, FilePath, DirectoryPath, ConnectionString
            <input class="df-input" value="@JsonValues.ToText(Value)" @oninput="OnStringInput" data-testid="editor-@Property.Name" />
            break;
    }

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="df-field-error" data-testid="error-@Property.Name">⚠ @Error</div>
    }

    @* 🔗 G4 — insert-a-binding picker on text-like editors + bound-value badge. *@
    @if (SupportsTokens)
    {
        <div class="df-token-row">
            @if (VariableTokens.ContainsToken(JsonValues.ToText(Value)))
            {
                @if (UnresolvableBinding)
                {
                    <span class="df-token-badge df-token-badge--bad" data-testid="unbound-@Property.Name"
                          title="This binding can't resolve — the node will fail at run time">⚠️ unresolved</span>
                    @if (CanEscapeLiteral)
                    {
                        <button type="button" class="df-btn df-btn--small" data-testid="escape-braces-@Property.Name"
                                title="Treat these braces as literal text instead of a binding"
                                @onclick="EscapeLiteralBraces">escape as literal</button>
                    }
                }
                else
                {
                    <span class="df-token-badge" data-testid="bound-@Property.Name" title="Contains a {{…}} binding resolved at run time">🔗 bound</span>
                }
            }
            @if (TokenOptions is { Count: > 0 })
            {
                <button type="button" class="df-btn df-btn--small" data-testid="token-btn-@Property.Name"
                        title="Insert a variable or upstream output binding"
                        @onclick="() => tokenPickerOpen = !tokenPickerOpen">{{x}}</button>
            }
            @* ƒx available on every template-supporting field (paths/text accept {{…}} too). *@
            <button type="button" class="df-btn df-btn--small" data-testid="exprb-btn-@Property.Name"
                    title="Open the expression builder"
                    @onclick="OpenBuilder">ƒx builder</button>
        </div>
        @if (tokenPickerOpen && TokenOptions is { Count: > 0 })
        {
            <div class="df-token-list" data-testid="token-list-@Property.Name">
                @foreach (var group in TokenOptions.GroupBy(o => o.Category))
                {
                    <div class="df-token-list__group">@group.Key</div>
                    @if (group.Key == VariableTokens.GlobalsCategory)
                    {
                        @* V3.5 / Q16 — globals shipped ahead of secret support, so say so plainly
                           right where someone is about to reach for one. *@
                        <div class="df-field-help" data-testid="globals-warning-@Property.Name">
                            @VariableTokens.GlobalsCredentialWarning
                        </div>
                    }
                    @foreach (var option in group)
                    {
                        <button type="button" class="df-token-list__item" title="@option.Detail"
                                @onclick="() => InsertToken(option)">@option.Label</button>
                    }
                }
            </div>
        }
    }

    @* ƒx G8 — expression builder modal: hints + Variable/input builders. *@
    @if (builderOpen)
    {
        <div class="df-modal-backdrop" data-testid="exprb-@Property.Name" @onclick="() => builderOpen = false">
            <div class="df-nodemodal" @onclick:stopPropagation="true">
                <div class="df-props__header">
                    <strong>ƒx Expression — @Property.DisplayName</strong>
                    @if (!string.IsNullOrWhiteSpace(Property.Description))
                    {
                        <div class="df-props__module">@Property.Description</div>
                    }
                </div>

                <textarea class="df-textarea df-input--mono" rows="3" data-testid="exprb-text-@Property.Name"
                          value="@builderText" @oninput="e => builderText = e.Value?.ToString() ?? string.Empty"></textarea>

                <div class="df-exprb__builder">
                    <label class="df-label">Build a binding</label>
                    <div class="df-row">
                        <select class="df-input" data-testid="exprb-source-@Property.Name" @onchange="e => builderToken = e.Value?.ToString() ?? string.Empty">
                            <option value="">— source —</option>
                            @if (TokenOptions is not null)
                            {
                                @foreach (var group in TokenOptions.GroupBy(o => o.Category))
                                {
                                    <optgroup label="@(group.Key == "Variables" ? "Variables" : "Inputs (upstream outputs)")">
                                        @foreach (var option in group)
                                        {
                                            <option value="@option.Token">@option.Label</option>
                                        }
                                    </optgroup>
                                }
                            }
                        </select>
                        <select class="df-input df-exprb__op" data-testid="exprb-op-@Property.Name" @onchange="e => builderOp = e.Value?.ToString()">
                            @foreach (var op in ExpressionBuilder.Operators)
                            {
                                <option value="@op">@op</option>
                            }
                        </select>
                        <input class="df-input" placeholder="value" data-testid="exprb-value-@Property.Name"
                               value="@builderValue" @oninput="e => builderValue = e.Value?.ToString()" />
                        <button type="button" class="df-btn" data-testid="exprb-insert-@Property.Name" @onclick="InsertBuilt">Insert</button>
                    </div>
                    <div class="df-field-help">Strings are auto-quoted; numbers and true/false stay raw.</div>
                </div>

                <div class="df-exprb__hints">
                    <label class="df-label">Hints</label>
                    @foreach (var (example, meaning) in ExpressionBuilder.Hints)
                    {
                        <div class="df-exprb__hint"><code>@example</code> — @meaning</div>
                    }
                </div>

                <div class="df-row">
                    <button type="button" class="df-btn df-btn--primary" data-testid="exprb-apply-@Property.Name" @onclick="ApplyBuilder">Apply</button>
                    <button type="button" class="df-btn" data-testid="exprb-cancel-@Property.Name" @onclick="() => builderOpen = false">Cancel</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool jsonInvalid;
    private bool tokenPickerOpen;

    /// <summary>The property schema definition.</summary>
    [Parameter, EditorRequired]
    public ModulePropertyDefinitionDto Property { get; set; } = default!;

    /// <summary>Pickable binding tokens (variables + upstream outputs); null hides the picker.</summary>
    [Parameter]
    public IReadOnlyList<VariableTokens.TokenOption>? TokenOptions { get; set; }

    /// <summary>
    /// 🧭 V7 — whether this value contains a <c>{{…}}</c> reference that can't resolve, so the
    /// badge can say "unresolved" instead of implying everything is wired up.
    /// </summary>
    [Parameter]
    public bool UnresolvableBinding { get; set; }

    /// <summary>
    /// 🧹 V7.4 — whether the migration quick-fix is safe to offer. Only true when *every* reference
    /// in the value is unresolvable, so escaping can't silently break a working binding.
    /// </summary>
    [Parameter]
    public bool CanEscapeLiteral { get; set; }

    private Task EscapeLiteralBraces()
        => this.ValueChanged.InvokeAsync(
            JsonValues.FromString(VariableLint.EscapeBraces(JsonValues.ToText(this.Value))));

    /// <summary>
    /// Whether to offer the <c>{{x}}</c> picker and ƒx builder on this field.
    /// </summary>
    /// <remarks>
    /// V4: driven by the module schema's <c>SupportsTemplates</c> flag rather than a hard-coded
    /// editor-type list. Engine and UI now share one source of truth, so the designer can never
    /// invite a binding into a field the engine leaves literal — which is exactly what Round 2
    /// shipped by accident.
    /// </remarks>
    private bool SupportsTokens => this.Property.SupportsTemplates;

    // ƒx G8 — expression builder modal state.
    private bool builderOpen;
    private string builderText = string.Empty;
    private string builderToken = string.Empty;
    private string? builderOp = ExpressionBuilder.NoOperator;
    private string? builderValue;

    private void OpenBuilder()
    {
        this.builderText = JsonValues.ToText(this.Value);
        this.builderToken = string.Empty;
        this.builderOp = ExpressionBuilder.NoOperator;
        this.builderValue = null;
        this.builderOpen = true;
    }

    private void InsertBuilt()
    {
        if (string.IsNullOrEmpty(this.builderToken))
        {
            return;
        }

        var composed = ExpressionBuilder.Compose(this.builderToken, this.builderOp, this.builderValue);
        this.builderText = string.IsNullOrEmpty(this.builderText) ? composed : this.builderText + composed;
    }

    private Task ApplyBuilder()
    {
        this.builderOpen = false;
        return this.ValueChanged.InvokeAsync(JsonValues.FromString(this.builderText));
    }

    private Task InsertToken(VariableTokens.TokenOption option)
    {
        this.tokenPickerOpen = false;
        var current = JsonValues.ToText(this.Value);
        var next = string.IsNullOrEmpty(current) ? option.Token : current + option.Token;
        return this.ValueChanged.InvokeAsync(JsonValues.FromString(next));
    }

    /// <summary>The current value.</summary>
    [Parameter]
    public JsonElement Value { get; set; }

    /// <summary>Raised when the value changes.</summary>
    [Parameter]
    public EventCallback<JsonElement> ValueChanged { get; set; }

    /// <summary>The Monaco language for a <c>Code</c> editor (from a sibling <c>language</c> property).</summary>
    [Parameter]
    public string CodeLanguage { get; set; } = "plaintext";

    /// <summary>An inline validation error to show, if any.</summary>
    [Parameter]
    public string? Error { get; set; }

    private string JsonText => Value.ValueKind == JsonValueKind.Undefined ? string.Empty : Value.GetRawText();

    /// <summary>The hover tooltip: description plus the declared default, when present (G3)~ 💬.</summary>
    private string? Tooltip
    {
        get
        {
            var desc = this.Property.Description;
            var def = this.Property.DefaultValue is JsonElement d && d.ValueKind is not (JsonValueKind.Null or JsonValueKind.Undefined)
                ? $"Default: {JsonValues.ToText(d)}"
                : null;
            return (desc, def) switch
            {
                (null or "", null) => null,
                (null or "", _) => def,
                (_, null) => desc,
                _ => $"{desc}\n{def}",
            };
        }
    }

    private IReadOnlyList<string> AllowedOptions
    {
        get
        {
            var list = new List<string>();
            if (Property.AllowedValues is not null)
            {
                foreach (var v in Property.AllowedValues)
                {
                    list.Add(JsonValues.ToText(v));
                }
            }

            return list;
        }
    }

    private Task OnStringInput(ChangeEventArgs e) => this.ValueChanged.InvokeAsync(JsonValues.FromString(e.Value?.ToString()));

    private Task OnStringChange(ChangeEventArgs e)
    {
        // A dropdown's "(auto)" option means "unset" — store null so module validation
        // treats it as omitted rather than an invalid empty string.
        var text = e.Value?.ToString();
        return this.ValueChanged.InvokeAsync(string.IsNullOrEmpty(text) ? JsonValues.Null : JsonValues.FromString(text));
    }

    private Task OnStringChangeText(string value) => this.ValueChanged.InvokeAsync(JsonValues.FromString(value));

    private Task OnNumberInput(ChangeEventArgs e) => this.ValueChanged.InvokeAsync(JsonValues.FromNumber(e.Value?.ToString()));

    private Task OnBoolChange(ChangeEventArgs e) => this.ValueChanged.InvokeAsync(JsonValues.FromBool(e.Value is bool b && b));

    private Task OnJsonEditorChange(string value)
    {
        var parsed = JsonValues.TryParseJson(value);
        this.jsonInvalid = parsed is null;
        return parsed is null ? Task.CompletedTask : this.ValueChanged.InvokeAsync(parsed.Value);
    }
}
