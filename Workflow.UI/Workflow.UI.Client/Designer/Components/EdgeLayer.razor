@namespace Workflow.UI.Client.Designer.Components
@using System.Globalization
@using Workflow.UI.Client.Designer.State

<svg class="df-edges" style="width:@(Extent.W.ToString(Inv))px; height:@(Extent.H.ToString(Inv))px;">
    <defs>
        <marker id="df-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
            <path d="M0,0 L8,4 L0,8 Z" fill="var(--df-border)"></path>
        </marker>
        <marker id="df-arrow-sel" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
            <path d="M0,0 L8,4 L0,8 Z" fill="var(--df-accent)"></path>
        </marker>
        <marker id="df-arrow-error" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
            <path d="M0,0 L8,4 L0,8 Z" fill="var(--df-state-failed)"></path>
        </marker>
    </defs>
    @* 🚑 §12.7 — dashed "on error" links: from a node that runs an error handler to its handler. *@
    @foreach (var link in ErrorLinks)
    {
        <g class="df-edge-group df-edge-group--onerror" data-testid="error-link" data-error-link="@(link.From)→@(link.To)">
            <path class="df-edge df-edge--onerror" d="@link.Path" fill="none" stroke="var(--df-state-failed)"
                  stroke-width="1.5" stroke-dasharray="3 4" marker-end="url(#df-arrow-error)" />
            <text class="df-edge__label" x="@link.LabelX.ToString(Inv)" y="@link.LabelY.ToString(Inv)" fill="var(--df-state-failed)">on error</text>
        </g>
    }
    @foreach (var e in Edges)
    {
        var selected = Selection is not null && Selection.IsConnectionSelected(e.Key);
        <g class="df-edge-group">
            @if (Selection is not null)
            {
                <path class="df-edge-hit" d="@e.Path"
                      data-testid="edge-hit"
                      data-edge-key="@e.Key"
                      @onpointerdown="() => Select(e.Key)" @onpointerdown:stopPropagation="true"
                      @oncontextmenu="args => OnContextMenu(e.Key, args)" @oncontextmenu:stopPropagation="true" @oncontextmenu:preventDefault="true" />
            }
            <path class="df-edge @(selected ? "df-edge--selected" : string.Empty) @(e.Structural ? "df-edge--structural" : string.Empty) @(e.Streaming ? "df-edge--stream" : string.Empty)" d="@e.Path"
                  data-edge-streaming="@(e.Streaming ? "true" : null)"
                  fill="none" stroke="@(selected ? "var(--df-accent)" : e.Streaming ? "var(--df-stream, #2aa9c4)" : "var(--df-border)")"
                  stroke-width="@(selected ? "3" : e.Streaming ? "3" : "2")"
                  stroke-dasharray="@(e.RunAfter ? "2 4" : e.Structural ? "6 4" : null)"
                  data-edge-kind="@(e.RunAfter ? "RunAfter" : null)"
                  marker-end="@(selected ? "url(#df-arrow-sel)" : "url(#df-arrow)")" />
            @if (!string.IsNullOrWhiteSpace(e.Condition))
            {
                @((MarkupString)LabelMarkup(e))
            }
        </g>
    }
</svg>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    /// <summary>The document whose connections to draw.</summary>
    [Parameter, EditorRequired]
    public DesignerDocument Document { get; set; } = default!;

    /// <summary>The current selection (null in read-only run mode → edges are not clickable).</summary>
    [Parameter]
    public SelectionState? Selection { get; set; }

    /// <summary>Raised on right-click of an edge (connection key + args).</summary>
    [Parameter]
    public EventCallback<(string Key, Microsoft.AspNetCore.Components.Web.MouseEventArgs Args)> OnConnectionContextMenu { get; set; }

    private void Select(string key) => this.Selection?.SelectConnection(key);

    private static string LabelMarkup(EdgeRender e)
        => System.FormattableString.Invariant(
            $"<text class=\"df-edge__label\" x=\"{e.LabelX}\" y=\"{e.LabelY}\" fill=\"var(--df-text-dim)\">{System.Net.WebUtility.HtmlEncode(e.Condition)}</text>");

    private Task OnContextMenu(string key, Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        this.Selection?.SelectConnection(key);
        return this.OnConnectionContextMenu.InvokeAsync((key, args));
    }

    private (double W, double H) Extent
    {
        get
        {
            double maxX = 1000, maxY = 800;
            foreach (var n in Document.Nodes)
            {
                var b = CanvasGeometry.NodeBounds(n.X, n.Y, NodePorts.Inputs(n).Count, NodePorts.Outputs(n).Count);
                maxX = System.Math.Max(maxX, b.Right + 200);
                maxY = System.Math.Max(maxY, b.Bottom + 200);
            }

            return (maxX, maxY);
        }
    }

    private IEnumerable<EdgeRender> Edges
    {
        get
        {
            foreach (var c in Document.Connections)
            {
                var source = Document.FindNode(c.SourceNodeId);
                var target = Document.FindNode(c.TargetNodeId);
                if (source is null || target is null)
                {
                    continue;
                }

                var s = NodePorts.Anchor(source, c.SourcePortName, isOutput: true);
                // ⏭️ Plan 09 — a run-after edge meets the node's top edge, dotted, labelled "after"~
                var t = c.IsRunAfter ? RunAfterEdges.Anchor(target) : NodePorts.Anchor(target, c.TargetPortName, isOutput: false);
                var label = EdgeConditions.Label(c); // 🔀 Stage 7.2: "2: value > 10" / "3: else"
                if (c.IsRunAfter)
                {
                    label = string.IsNullOrWhiteSpace(label) ? "after" : $"after · {label}";
                }

                yield return new EdgeRender(
                    c.Key,
                    CanvasGeometry.BezierPath(s, t),
                    label,
                    (s.X + t.X) / 2,
                    ((s.Y + t.Y) / 2) - 4,
                    NodePorts.IsStructuralEdge(source, c.SourcePortName),
                    StreamGraph.IsStreamingEdge(Document, c),
                    c.IsRunAfter);
            }
        }
    }

    private IEnumerable<ErrorLinkRender> ErrorLinks
    {
        get
        {
            foreach (var link in NodeErrorHandling.Links(Document))
            {
                var source = Document.FindNode(link.NodeId)!;
                var handler = Document.FindNode(link.HandlerId)!;
                var from = CanvasGeometry.NodeBounds(source.X, source.Y, NodePorts.Inputs(source).Count, NodePorts.Outputs(source).Count);
                var to = CanvasGeometry.NodeBounds(handler.X, handler.Y, NodePorts.Inputs(handler).Count, NodePorts.Outputs(handler).Count);

                // From the bottom-centre of the failing node to the top-centre of its handler~
                var s = new Point(from.X + (from.Width / 2), from.Bottom);
                var t = new Point(to.X + (to.Width / 2), to.Y);
                yield return new ErrorLinkRender(
                    link.NodeId,
                    link.HandlerId,
                    System.FormattableString.Invariant($"M {s.X} {s.Y} C {s.X} {s.Y + 60}, {t.X} {t.Y - 60}, {t.X} {t.Y}"),
                    ((s.X + t.X) / 2) + 6,
                    (s.Y + t.Y) / 2);
            }
        }
    }

    private readonly record struct ErrorLinkRender(string From, string To, string Path, double LabelX, double LabelY);

    private readonly record struct EdgeRender(
        string Key,
        string Path,
        string? Condition,
        double LabelX,
        double LabelY,
        bool Structural,
        bool Streaming,
        bool RunAfter = false);
}

