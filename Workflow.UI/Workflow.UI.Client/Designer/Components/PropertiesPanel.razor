@namespace Workflow.UI.Client.Designer.Components
@using System.Linq
@using System.Text.Json
@using Workflow.UI.Client.Designer.State
@using Workflow.UI.Client.Designer.State.Commands
@using Workflow.UI.Client.Scripts.State
@inject NavigationManager Nav
@inject ScriptStudioHandoff Handoff
@inject Workflow.UI.Client.Linq.State.LinqStudioHandoff LinqHandoff
@inject IJSRuntime JS

<div class="df-props">
    @if (SelectedNode is not null)
    {
        <div class="df-props__header">
            <input class="df-input" @bind="nameBuffer" data-testid="prop-name" />
            <div class="df-props__module">@SelectedNode.ModuleId</div>
            @if (SelectedNode.Metadata.TryGetValue("moduleVersion", out var ver))
            {
                <span class="df-props__version" title="pinned module version">📌 v@ver</span>
            }
        </div>

        @if (StructuralHint is not null)
        {
            <div class="df-props__hint" data-testid="structural-hint">💡 @StructuralHint</div>
        }

        @if (OutputShapingUx.IsEligible(SelectedNode))
        {
            <div class="df-field">
                <label class="df-label">Output mode</label>
                <select class="df-input" data-testid="output-mode" @onchange="OnOutputModeChanged">
                    <option value="ports" selected="@(!OutputShapingUx.IsMerged(SelectedNode))">ports — each output separately</option>
                    <option value="merged" selected="@(OutputShapingUx.IsMerged(SelectedNode))">merged — one 'output' object</option>
                </select>
                <div class="df-field-help">changes this node's output ports</div>
            </div>
        }

        @* 📤 G6 — live outputs strip: the node's current output ports (reflects merged/meta). *@
        <div class="df-field">
            <label class="df-label">Outputs</label>
            <div class="df-outputs-strip" data-testid="outputs-strip">
                @foreach (var port in NodePorts.Outputs(SelectedNode))
                {
                    <span class="df-outputs-strip__port" title="@OutputDescriptionFor(port)">@port</span>
                }
            </div>
        </div>

        @* 🔎 Input-shape hinting (T4/T7) — what's arriving at this node, and how to address it. *@
        @if (IncomingRows.Count > 0)
        {
            <div class="df-field df-incoming" data-testid="incoming-data">
                @if (FanInShape.IsFanIn(SelectedNode))
                {
                    var branches = FanInShape.Branches(Document, SelectedNode.Id);
                    <label class="df-label">Incoming branches <span class="df-incoming__order-note">(order matters for merge/first/last)</span></label>
                    @for (var i = 0; i < branches.Count; i++)
                    {
                        var branch = branches[i];
                        var idx = i;
                        <div class="df-incoming__row" data-testid="fanin-branch-@idx">
                            <span class="df-incoming__index">@(idx + 1).</span>
                            <span>@branch.SourceNodeName · @branch.SourcePortName</span>
                            <span class="df-incoming__reorder">
                                <button type="button" class="df-btn df-btn--small" data-testid="branch-up-@idx"
                                        disabled="@(idx == 0)" title="Move this branch earlier"
                                        @onclick="() => ReorderBranch(idx, idx - 1)">↑</button>
                                <button type="button" class="df-btn df-btn--small" data-testid="branch-down-@idx"
                                        disabled="@(idx == branches.Count - 1)" title="Move this branch later"
                                        @onclick="() => ReorderBranch(idx, idx + 1)">↓</button>
                            </span>
                        </div>
                    }
                    <div class="df-field-help" data-testid="fanin-shape">@FanInShape.ShapeSummary(Document, SelectedNode)</div>
                    @if (FanInKnownIssueNote is { } fanInNote)
                    {
                        <div class="df-field-help df-incoming__warn" data-testid="fanin-note">⚠ @fanInNote</div>
                    }
                }
                else
                {
                    <label class="df-label">Incoming data</label>
                    @foreach (var row in IncomingRows)
                    {
                        var rowToken = string.Equals(row.PortName, "input", StringComparison.OrdinalIgnoreCase)
                            ? VariableTokens.SelfInputToken
                            : VariableTokens.OutputToken(row.SourceNodeId, row.SourcePortName);
                        <div class="df-incoming__row" data-testid="incoming-@row.PortName">
                            <code>@row.PortName</code>
                            <span>←</span>
                            <button type="button" class="df-link" title="Insert @rowToken"
                                    @onclick="() => InsertHintToken(rowToken)">@row.SourceNodeName · @row.SourcePortName</button>
                            @if (row.Keys.Count > 0)
                            {
                                <span class="df-incoming__keys">
                                    @foreach (var key in row.Keys)
                                    {
                                        <button type="button" class="df-link df-incoming__key" title="Insert @key.Token"
                                                @onclick="() => InsertHintToken(key.Token)">@KeyLeaf(key.Label)</button>
                                    }
                                </span>
                            }
                        </div>
                    }
                    <div class="df-field-help">Click to insert the token into the focused field (copied to the clipboard otherwise).</div>
                }
            </div>
        }

        @* 🧩 Split preview (V2) — which keys land on which port, before any run. *@
        @if (SelectedNode.ModuleId == "builtin.split")
        {
            <div class="df-field df-splitpreview" data-testid="split-preview">
                <label class="df-label">Split preview</label>
                @if (SplitUpstreamShapeKeys is { } shapeKeys)
                {
                    <div class="df-field-help" data-testid="split-shape-source">Shape derived from the merged upstream node — no sample needed.</div>
                    @foreach (var row in Workflow.UI.Client.Designer.State.SplitPreview.ComputeFromShape(shapeKeys, SplitKeys, SplitRestPort).Rows)
                    {
                        <div class="df-incoming__row" data-testid="split-row-@row.Port">
                            <code>@row.Port</code>
                            <span>→</span>
                            <span class="@(row.IsMissing ? "df-splitpreview__missing" : "")">@row.ValuePreview</span>
                            @if (row.IsMissing)
                            {
                                <span class="df-splitpreview__missing" title="This key isn't on the arriving object — the port emits null at run time">⚠ not present</span>
                            }
                        </div>
                    }
                }
                else
                {
                    <textarea class="df-textarea df-splitpreview__sample" data-testid="split-sample"
                              placeholder='{ "Foo": 1, "Bar": "hello" }'
                              value="@sampleBuffer" @onchange="OnSampleChanged"></textarea>
                    <label class="df-splitpreview__persist">
                        <input type="checkbox" data-testid="split-persist" checked="@SamplePersisted" @onchange="OnPersistToggled" />
                        keep this sample in the workflow (shared with the team)
                    </label>
                    @if (persistConfirmOpen)
                    {
                        <div class="df-splitpreview__confirm" data-testid="split-persist-confirm">
                            <span>A sample is stored in the workflow — what should happen to it?</span>
                            <button type="button" class="df-btn df-btn--small df-btn--primary" data-testid="split-persist-remove"
                                    @onclick="RemoveStoredSample">Remove stored sample</button>
                            <button type="button" class="df-btn df-btn--small" data-testid="split-persist-keep"
                                    @onclick="() => persistConfirmOpen = false">Keep it (edits stay session-only)</button>
                        </div>
                    }
                    var preview = Workflow.UI.Client.Designer.State.SplitPreview.Compute(sampleBuffer, SplitKeys, SplitRestPort);
                    if (!preview.Success)
                    {
                        <div class="df-field-help" data-testid="split-preview-empty">@preview.Error</div>
                    }
                    else
                    {
                        @foreach (var row in preview.Rows)
                        {
                            <div class="df-incoming__row" data-testid="split-row-@row.Port">
                                <code>@row.Port</code>
                                <span>→</span>
                                <span class="@(row.IsMissing ? "df-splitpreview__missing" : "")">@row.ValuePreview</span>
                                @if (row.IsMissing)
                                {
                                    <span class="df-splitpreview__missing" title="This key isn't in the sample — the port emits null at run time">⚠ not in sample</span>
                                }
                            </div>
                        }
                    }
                }
            </div>
        }

        @if (SelectedNode.Schema is { Properties.Count: > 0 } schema)
        {
            @foreach (var prop in schema.Properties)
            {
                <PropertyEditor Property="prop"
                                Value="@ValueFor(prop.Name)"
                                CodeLanguage="@CodeLanguageFor()"
                                Error="@ErrorFor(prop)"
                                TokenOptions="@NodeTokenOptions"
                                UnresolvableBinding="@IsUnresolvable(prop.Name)"
                                CanEscapeLiteral="@CanEscapeLiteral(prop.Name)"
                                Focused="name => lastFocusedProperty = name"
                                ValueChanged="v => OnValueChanged(prop.Name, v)" />
            }
        }
        else
        {
            <div class="df-empty">This module has no configurable properties.</div>
        }

        <div class="df-row">
            <button class="df-btn df-btn--primary" data-testid="apply" @onclick="Apply">Apply</button>
            <button class="df-btn" @onclick="Reset">Reset</button>
            <button class="df-btn" data-testid="expand-editor" title="Edit in a larger window" @onclick="() => modalOpen = true">⤢ Expand</button>
            @if (SqlPropertyName is not null)
            {
                <button class="df-btn" data-testid="sqlparams-btn" title="Safely bind values as SQL parameters" @onclick="OpenSqlParams">🛡️ SQL parameters</button>
            }
        </div>
        @if (IsScriptNode)
        {
            <button class="df-btn df-btn--link" data-testid="edit-in-studio" @onclick="OpenInScriptStudio">Edit in Script Studio →</button>
        }
        @if (IsLinqNode)
        {
            <button class="df-btn df-btn--link" data-testid="edit-in-linq-studio" @onclick="OpenInLinqStudio">Open in Linq Studio →</button>
        }

        @* 🛡️ G9 — safe SQL parameter builder: values bind as parameters, never concatenated (D7). *@
        @if (sqlParamsOpen && SqlPropertyName is { } sqlProp)
        {
            <div class="df-modal-backdrop df-modal-backdrop--top" data-testid="sqlparams-modal" @onclick="() => sqlParamsOpen = false">
                <div class="df-nodemodal" @onclick:stopPropagation="true">
                    <div class="df-props__header">
                        <strong>🛡️ SQL parameters — @SelectedNode.Name</strong>
                        <div class="df-props__module">SQL is verbatim (never template-expanded). Put values here — they bind as parameters, never concatenated into the SQL.</div>
                    </div>

                    <label class="df-label">Current parameters</label>
                    @{ var entries = SqlParams.Parse(BufferedParameters); }
                    @if (entries.Count == 0)
                    {
                        <div class="df-field-help">None yet — add one below, then reference it in the SQL as <code>@("@name")</code>.</div>
                    }
                    else
                    {
                        @foreach (var (name, value) in entries)
                        {
                            <div class="df-sqlparams__row" data-testid="sqlparam-@name">
                                <code>@SqlParams.Placeholder(name)</code>
                                <span class="df-sqlparams__value">@value</span>
                                @if (VariableTokens.ContainsToken(value))
                                {
                                    <span class="df-token-badge" data-testid="sqlparam-bound-@name"
                                          title="Bound at run time to the referenced variable / upstream output">🔗 bound</span>
                                }
                                <button type="button" class="df-btn df-btn--small" title="Insert the placeholder into the SQL"
                                        @onclick="() => InsertSqlPlaceholder(name)">insert @("@" + name)</button>
                                <button type="button" class="df-btn df-btn--small df-btn--danger" data-testid="sqlparam-remove-@name"
                                        @onclick="() => RemoveSqlParam(name)">✕</button>
                            </div>
                        }
                    }

                    <label class="df-label">Add a parameter</label>
                    <div class="df-row">
                        <input class="df-input" placeholder="name" data-testid="sqlparam-name"
                               value="@sqlParamName" @oninput="e => sqlParamName = e.Value?.ToString()" />
                        <input class="df-input" placeholder="value — literal or {{binding}}" data-testid="sqlparam-value"
                               value="@sqlParamValue" @oninput="e => sqlParamValue = e.Value?.ToString()" />
                        <button type="button" class="df-btn df-btn--primary" data-testid="sqlparam-add" @onclick="AddSqlParam">Add + insert</button>
                    </div>
                    @if (NodeTokenOptions is { Count: > 0 })
                    {
                        <div class="df-row">
                            <select class="df-input" data-testid="sqlparam-bind-source" @onchange="OnSqlParamBindSource">
                                <option value="">🔗 …or bind the value from a variable / input</option>
                                @foreach (var group in NodeTokenOptions.GroupBy(o => o.Category))
                                {
                                    <optgroup label="@(group.Key == "Variables" ? "Variables" : "Inputs (upstream outputs)")">
                                        @foreach (var option in group)
                                        {
                                            <option value="@option.Token">@option.Label</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>
                    }
                    <div class="df-field-help">
                        Adds <code>"name": value</code> to the Parameters map and appends <code>@("@name")</code> to the SQL.
                        Literals: numbers and true/false stay typed, everything else binds as text.
                        Bindings like <code>{{Variable.customerId}}</code> or <code>{{http-1.body}}</code> resolve at
                        run time — either way the value binds as a parameter, never concatenated into the SQL.
                    </div>

                    <div class="df-row">
                        <button type="button" class="df-btn" data-testid="sqlparams-close" @onclick="() => sqlParamsOpen = false">Close</button>
                    </div>
                </div>
            </div>
        }

        @* 🪟 G5 — modal node inspector: SAME buffer + Apply as the panel (no divergence). *@
        @if (modalOpen && SelectedNode is not null)
        {
            <div class="df-modal-backdrop" data-testid="node-modal" @onclick="() => modalOpen = false">
                <div class="df-nodemodal" @onclick:stopPropagation="true">
                    <div class="df-props__header">
                        <input class="df-input" @bind="nameBuffer" data-testid="modal-prop-name" />
                        <div class="df-props__module">@SelectedNode.ModuleId</div>
                    </div>
                    <div class="df-field">
                        <label class="df-label">Outputs</label>
                        <div class="df-outputs-strip">
                            @foreach (var port in NodePorts.Outputs(SelectedNode))
                            {
                                <span class="df-outputs-strip__port" title="@OutputDescriptionFor(port)">@port</span>
                            }
                        </div>
                    </div>
                    <div class="df-nodemodal__body">
                        @if (SelectedNode.Schema is { Properties.Count: > 0 } modalSchema)
                        {
                            @foreach (var prop in modalSchema.Properties)
                            {
                                <PropertyEditor Property="prop"
                                                Value="@ValueFor(prop.Name)"
                                                CodeLanguage="@CodeLanguageFor()"
                                                Error="@ErrorFor(prop)"
                                                TokenOptions="@NodeTokenOptions"
                                UnresolvableBinding="@IsUnresolvable(prop.Name)"
                                CanEscapeLiteral="@CanEscapeLiteral(prop.Name)"
                                                ValueChanged="v => OnValueChanged(prop.Name, v)" />
                            }
                        }
                        else
                        {
                            <div class="df-empty">This module has no configurable properties.</div>
                        }
                    </div>
                    <div class="df-row">
                        <button class="df-btn df-btn--primary" data-testid="modal-apply" @onclick="ApplyAndCloseModal">Apply</button>
                        <button class="df-btn" data-testid="modal-cancel" @onclick="CancelModal">Cancel</button>
                        @if (SqlPropertyName is not null)
                        {
                            <button class="df-btn" data-testid="modal-sqlparams-btn" title="Safely bind values as SQL parameters" @onclick="OpenSqlParams">🛡️ SQL parameters</button>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else if (SelectedConnection is not null)
    {
        <div class="df-props__header">
            <div class="df-props__module">🔗 Connection</div>
        </div>
        <div class="df-field">
            <label class="df-label">From</label>
            <div class="df-props__conn" data-testid="conn-from">@NodeName(SelectedConnection.SourceNodeId) · @SelectedConnection.SourcePortName</div>
        </div>
        <div class="df-field">
            <label class="df-label">To</label>
            <div class="df-props__conn" data-testid="conn-to">@NodeName(SelectedConnection.TargetNodeId) · @SelectedConnection.TargetPortName</div>
        </div>
        <div class="df-field">
            <label class="df-label">Condition (optional)</label>
            <input class="df-input" data-testid="conn-condition" @bind="connCondition" placeholder="e.g. output.status == 200" />
        </div>
        <div class="df-row">
            <button class="df-btn df-btn--primary" data-testid="conn-apply" @onclick="ApplyConnection">Apply</button>
            <button class="df-btn df-btn--danger" data-testid="conn-delete" @onclick="DeleteConnection">Delete</button>
        </div>
    }
    else if (Selection.Nodes.Count > 1)
    {
        <div class="df-props__multi">@Selection.Nodes.Count nodes selected</div>
    }
    else
    {
        <div class="df-props__workflow">
            <h3>Workflow</h3>
            <div class="df-field">
                <label class="df-label">Name</label>
                <input class="df-input" @bind="wfName" data-testid="wf-name" />
            </div>
            <div class="df-field">
                <label class="df-label">Description</label>
                <textarea class="df-textarea" @bind="wfDescription" data-testid="wf-description"></textarea>
            </div>
            <div class="df-field">
                <label class="df-label">Tags (comma-separated)</label>
                <input class="df-input" @bind="wfTags" data-testid="wf-tags" />
            </div>
            <button class="df-btn df-btn--primary" data-testid="wf-apply" @onclick="ApplyWorkflowMeta">Apply</button>
            <VariablesPanel Document="Document" Commands="Commands" />
        </div>
    }
</div>

@code {
    private string? seededNodeId;
    private readonly Dictionary<string, JsonElement> buffer = new();
    private string nameBuffer = string.Empty;
    private bool modalOpen;

    // 🔎 Input-shape hinting (T4/Q2) — the property editor that last had focus, so hint tokens
    // can insert there; clipboard is the fallback when nothing was focused yet.
    private string? lastFocusedProperty;

    // 🧩 Split preview (V2/V3) — session sample text, persist preference, and the toggle-off confirm.
    private string sampleBuffer = string.Empty;
    private bool samplePersistPreference;
    private bool persistConfirmOpen;

    // 🛡️ G9 — SQL parameter builder state.
    private bool sqlParamsOpen;
    private string? sqlParamName;
    private string? sqlParamValue;

    private string wfName = string.Empty;
    private string? wfDescription;
    private string wfTags = string.Empty;
    private bool wfSeeded;

    private string? seededConnKey;
    private string connCondition = string.Empty;

    /// <summary>The document.</summary>
    [Parameter, EditorRequired]
    public DesignerDocument Document { get; set; } = default!;

    /// <summary>The current selection.</summary>
    [Parameter, EditorRequired]
    public SelectionState Selection { get; set; } = default!;

    /// <summary>The command stack (edits are pushed here).</summary>
    [Parameter, EditorRequired]
    public CommandStack Commands { get; set; } = default!;

    /// <summary>
    /// 🌍 V6 — global variable names fetched once per designer session, offered in the token
    /// picker as a read-only third group. Null or empty simply hides the group, so the picker
    /// never becomes a hard dependency on the variables API being reachable.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<string>? GlobalVariableNames { get; set; }

    private DesignerNode? SelectedNode
        => this.Selection.Nodes.Count == 1 ? this.Document.FindNode(System.Linq.Enumerable.First(this.Selection.Nodes)) : null;

    private DesignerConnection? SelectedConnection
        => this.Selection.Connections.Count == 1
            ? this.Document.Connections.FirstOrDefault(c => c.Key == Enumerable.First(this.Selection.Connections))
            : null;

    private string NodeName(string nodeId) => this.Document.FindNode(nodeId)?.Name ?? nodeId;

    /// <summary>🔗 G4 — the binding tokens pickable for the selected node~.</summary>
    private IReadOnlyList<VariableTokens.TokenOption>? NodeTokenOptions
        => this.SelectedNode is { } node
            ? VariableTokens.OptionsFor(this.Document, node.Id, this.GlobalVariableNames)
            : null;

    /// <summary>🧭 V7 — whether a property's current value holds a binding that can't resolve~.</summary>
    private bool IsUnresolvable(string propertyName)
        => this.SelectedNode is { } node
           && VariableLint.HasUnresolvableReference(
               this.Document,
               node,
               propertyName,
               JsonValues.ToText(this.ValueFor(propertyName)),
               this.GlobalVariableNames);

    /// <summary>🧹 V7.4 — whether escaping the whole value is safe (nothing in it resolves)~.</summary>
    private bool CanEscapeLiteral(string propertyName)
        => this.SelectedNode is { } node
           && VariableLint.AllReferencesUnresolvable(
               this.Document,
               node,
               propertyName,
               JsonValues.ToText(this.ValueFor(propertyName)),
               this.GlobalVariableNames);

    /// <summary>📤 G6 — the schema description for an output port (tooltip)~.</summary>
    private string? OutputDescriptionFor(string port)
        => this.SelectedNode?.Schema?.Outputs?.FirstOrDefault(p => p.Name == port)?.Description
           ?? (port == OutputShapingUx.MergedPortName ? "All of this node's outputs as one object" : null);

    /// <summary>
    /// 🎚️ Applies the merged-output selection immediately as one undoable property edit
    /// (ports = property removed; merged = reserved <c>outputMode</c> property set).
    /// </summary>
    private void OnOutputModeChanged(ChangeEventArgs e)
    {
        var node = this.SelectedNode;
        if (node is null)
        {
            return;
        }

        var before = new Dictionary<string, JsonElement>(node.Properties);
        var after = new Dictionary<string, JsonElement>(node.Properties);
        if (e.Value?.ToString() == OutputShapingUx.Merged)
        {
            after[OutputShapingUx.PropertyName] = JsonSerializer.SerializeToElement(OutputShapingUx.Merged);
        }
        else
        {
            after.Remove(OutputShapingUx.PropertyName);
        }

        this.Commands.Execute(new EditNodePropertiesCommand(node.Id, before, after));
    }

    /// <summary>🔎 T4 — the selected node's wired inputs (empty when nothing selected/wired)~.</summary>
    private IReadOnlyList<InputShape.Incoming> IncomingRows
        => this.SelectedNode is { } node
            ? InputShape.IncomingFor(this.Document, node.Id)
            : System.Array.Empty<InputShape.Incoming>();

    // ── 🧩 Split preview (V2/V3) ──────────────────────────────────────────────────

    /// <summary>The split's configured keys, read from the live edit buffer~.</summary>
    private IReadOnlyList<string> SplitKeys => SplitPreview.ParseKeys(this.ValueFor("keys"));

    /// <summary>The split's configured rest port, read from the live edit buffer~.</summary>
    private string? SplitRestPort
        => JsonValues.ToText(this.ValueFor("restPort")) is { Length: > 0 } s && !string.IsNullOrWhiteSpace(s) ? s.Trim() : null;

    /// <summary>Q1a — upstream shape keys when the split's value comes from a merged node~.</summary>
    private IReadOnlyList<string>? SplitUpstreamShapeKeys
        => this.SelectedNode is { } node ? SplitPreview.UpstreamShapeKeys(this.Document, node) : null;

    /// <summary>Whether the sample is currently persisted (or set to persist)~.</summary>
    private bool SamplePersisted => this.samplePersistPreference;

    /// <summary>Sample text edited — update the session buffer, and the metadata when persisting~.</summary>
    private void OnSampleChanged(ChangeEventArgs e)
    {
        this.sampleBuffer = e.Value?.ToString() ?? string.Empty;
        if (this.samplePersistPreference && this.SelectedNode is { } node)
        {
            this.PersistSample(node, string.IsNullOrWhiteSpace(this.sampleBuffer) ? null : this.sampleBuffer);
        }
    }

    /// <summary>The persist toggle changed (Q2): ON stores the sample; OFF with a stored sample asks first~.</summary>
    private void OnPersistToggled(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        if (this.SelectedNode is not { } node)
        {
            return;
        }

        if (on)
        {
            this.samplePersistPreference = true;
            this.persistConfirmOpen = false;
            if (!string.IsNullOrWhiteSpace(this.sampleBuffer))
            {
                this.PersistSample(node, this.sampleBuffer);
            }

            return;
        }

        this.samplePersistPreference = false;
        if (SplitPreview.PersistedSample(node) is not null)
        {
            // Q2 follow-up — confirm what happens to the stored sample (primary: remove).
            this.persistConfirmOpen = true;
        }
    }

    /// <summary>Confirm choice: remove the stored sample from the workflow (undoable)~.</summary>
    private void RemoveStoredSample()
    {
        this.persistConfirmOpen = false;
        if (this.SelectedNode is { } node)
        {
            this.PersistSample(node, null);
        }
    }

    private void PersistSample(DesignerNode node, string? value)
    {
        var before = SplitPreview.PersistedSample(node);
        if (before != value)
        {
            this.Commands.Execute(new EditNodeMetadataCommand(node.Id, SplitPreview.SampleMetadataKey, before, value));
        }
    }

    /// <summary>
    /// ⚠ Q7 — an honest note about known FanIn runtime gaps, shown under the branch list. The J2
    /// zero-branches-in-sub-graphs bug is fixed, so this currently returns null — the slot stays
    /// so future known gaps surface here instead of letting the hint mislead~ 🧭.
    /// </summary>
    private string? FanInKnownIssueNote => null;

    /// <summary>🔀 T8 — moves a FanIn branch up/down as one undoable command~.</summary>
    private void ReorderBranch(int from, int to)
    {
        if (this.SelectedNode is { } node)
        {
            this.Commands.Execute(new ReorderIncomingConnectionCommand(node.Id, from, to));
        }
    }

    /// <summary>
    /// 🔎 T4/Q2 — inserts a hint token into the last-focused property editor's buffer; falls back
    /// to the clipboard when no editor has had focus yet~.
    /// </summary>
    private async Task InsertHintToken(string token)
    {
        if (this.lastFocusedProperty is { } prop
            && this.SelectedNode?.Schema?.Properties.Any(p => p.Name == prop && p.SupportsTemplates) == true)
        {
            var current = JsonValues.ToText(this.ValueFor(prop));
            this.OnValueChanged(prop, JsonValues.FromString(string.IsNullOrEmpty(current) ? token : current + token));
            return;
        }

        try
        {
            await this.JS.InvokeVoidAsync("navigator.clipboard.writeText", token);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // Clipboard unavailable (permissions/context) — nothing sensible to do~
        }
    }

    /// <summary>The last path segment of a key label (compact display in the keys row)~.</summary>
    private static string KeyLeaf(string label)
        => label.LastIndexOf('.') is var i && i >= 0 && i < label.Length - 1 ? label[(i + 1) ..] : label;

    /// <summary>A how-it-works callout for structural (loop / error-boundary) modules (UX-F4/F5)~ 💡.</summary>
    private string? StructuralHint => this.SelectedNode?.ModuleId switch
    {
        "builtin.loop.foreach" => "Loop: nodes connected from the loopBody port run once per item of the input collection. Their terminal output is collected into results; done fires when every iteration finishes.",
        "builtin.loop.while" => "Loop: nodes connected from the loopBody port run repeatedly while the condition holds. done fires when the loop exits.",
        "builtin.trycatch" => "Error boundary: nodes connected from try run first; if any fails, the catch branch runs. finally always runs, then done fires.",
        "builtin.database.transaction" => "Transaction: nodes connected from transactionBody run inside one open transaction — database nodes on the same connectionId join it automatically. All commit together (committed), or any failure rolls everything back (rolledBack). Leave 'operations' empty to use the body; fill it in to run a declarative op list instead.",
        _ => null,
    };

    protected override void OnParametersSet()
    {
        // Consume an edit returned from Script Studio (D9) — apply it as one undoable edit.
        if (this.Handoff.HasResult && this.Handoff.TakeResult() is { } result)
        {
            var target = this.Document.FindNode(result.NodeId);
            if (target is not null && (!target.Properties.TryGetValue("code", out var existing) || JsonValues.ToText(existing) != result.Code))
            {
                var before = new Dictionary<string, JsonElement>(target.Properties);
                var after = new Dictionary<string, JsonElement>(target.Properties) { ["code"] = JsonValues.FromString(result.Code) };
                this.Commands.Execute(new EditNodePropertiesCommand(target.Id, before, after));
                if (target.Id == this.seededNodeId)
                {
                    this.buffer["code"] = JsonValues.FromString(result.Code);
                }
            }
        }

        // Consume a published Linq Studio result — all authoring properties as one undoable edit~ 🧬
        if (this.LinqHandoff.HasResult && this.LinqHandoff.TakeResult() is { } linqResult)
        {
            var linqTarget = this.Document.FindNode(linqResult.NodeId);
            if (linqTarget is not null)
            {
                var beforeLinq = new Dictionary<string, JsonElement>(linqTarget.Properties);
                var afterLinq = new Dictionary<string, JsonElement>(linqTarget.Properties);
                foreach (var (key, value) in linqResult.Properties)
                {
                    afterLinq[key] = value;
                }

                this.Commands.Execute(new EditNodePropertiesCommand(linqTarget.Id, beforeLinq, afterLinq));
                if (linqTarget.Id == this.seededNodeId)
                {
                    this.SeedBuffer(linqTarget);
                }
            }
        }

        var node = this.SelectedNode;
        if (node is not null && node.Id != this.seededNodeId)
        {
            this.SeedBuffer(node);
        }
        else if (node is null)
        {
            this.seededNodeId = null;
            if (!this.wfSeeded)
            {
                this.SeedWorkflow();
            }
        }

        var conn = this.SelectedConnection;
        if (conn is not null && conn.Key != this.seededConnKey)
        {
            this.seededConnKey = conn.Key;
            this.connCondition = conn.Condition ?? string.Empty;
        }
        else if (conn is null)
        {
            this.seededConnKey = null;
        }
    }

    private bool IsScriptNode
        => this.SelectedNode is { ModuleId: "builtin.script" } && this.buffer.ContainsKey("code");

    private bool IsLinqNode => this.SelectedNode is { ModuleId: "builtin.database.linq" };

    private void OpenInLinqStudio()
    {
        var node = this.SelectedNode;
        if (node is null)
        {
            return;
        }

        var code = this.buffer.TryGetValue("userCode", out var uc) ? JsonValues.ToText(uc) : string.Empty;
        var conn = this.buffer.TryGetValue("connectionId", out var ci) ? JsonValues.ToText(ci) : string.Empty;
        var tables = new List<string>();
        if (this.buffer.TryGetValue("tableNames", out var tn) && tn.ValueKind == JsonValueKind.Array)
        {
            foreach (var el in tn.EnumerateArray())
            {
                if (el.ValueKind == JsonValueKind.String && el.GetString() is { Length: > 0 } s)
                {
                    tables.Add(s);
                }
            }
        }

        this.LinqHandoff.Request(node.Id, this.Document.Id.ToString(), code, conn, tables, this.Nav.Uri);
        this.Nav.NavigateTo("/linq-studio");
    }

    private void OpenInScriptStudio()
    {
        var node = this.SelectedNode;
        if (node is null)
        {
            return;
        }

        var code = this.buffer.TryGetValue("code", out var c) ? JsonValues.ToText(c) : string.Empty;
        this.Handoff.Request(node.Id, code, this.CodeLanguageFor(), this.Nav.Uri);
        this.Nav.NavigateTo("/scripts");
    }

    private void SeedBuffer(DesignerNode node)
    {
        this.seededNodeId = node.Id;
        this.nameBuffer = node.Name;
        this.buffer.Clear();
        foreach (var (k, v) in node.Properties)
        {
            this.buffer[k] = v;
        }

        // 🧩 V2/V3 — seed the split-preview sample from persisted metadata; persist mirrors presence.
        this.sampleBuffer = SplitPreview.PersistedSample(node) ?? string.Empty;
        this.samplePersistPreference = SplitPreview.PersistedSample(node) is not null;
        this.persistConfirmOpen = false;
    }

    private void SeedWorkflow()
    {
        this.wfSeeded = true;
        this.wfName = this.Document.Name;
        this.wfDescription = this.Document.Description;
        this.wfTags = string.Join(", ", this.Document.Tags);
    }

    private JsonElement ValueFor(string name)
        => this.buffer.TryGetValue(name, out var v) ? v : JsonValues.Null;

    private void OnValueChanged(string name, JsonElement value) => this.buffer[name] = value;

    private string? ErrorFor(ModulePropertyDefinitionDto prop)
    {
        if (prop.IsRequired)
        {
            var v = this.ValueFor(prop.Name);
            var isEmpty = v.ValueKind is JsonValueKind.Null or JsonValueKind.Undefined ||
                          (v.ValueKind == JsonValueKind.String && string.IsNullOrWhiteSpace(v.GetString()));
            if (isEmpty)
            {
                return "required";
            }
        }

        return null;
    }

    private string CodeLanguageFor()
    {
        if (this.buffer.TryGetValue("language", out var lang) && lang.ValueKind == JsonValueKind.String)
        {
            return lang.GetString() switch
            {
                "javascript" => "javascript",
                "csharp" => "csharp",
                "lua" => "lua",
                _ => "plaintext",
            };
        }

        return "plaintext";
    }

    private void Apply()
    {
        var node = this.SelectedNode;
        if (node is null)
        {
            return;
        }

        if (node.Name != this.nameBuffer)
        {
            this.Commands.Execute(new RenameNodeCommand(node.Id, node.Name, this.nameBuffer));
        }

        var before = new Dictionary<string, JsonElement>(node.Properties);
        var after = new Dictionary<string, JsonElement>(this.buffer);
        this.Commands.Execute(new EditNodePropertiesCommand(node.Id, before, after));
    }

    private void Reset()
    {
        var node = this.SelectedNode;
        if (node is not null)
        {
            this.SeedBuffer(node);
        }
    }

    /// <summary>🪟 G5 — modal Apply: same command path as the panel, then close~.</summary>
    private void ApplyAndCloseModal()
    {
        this.Apply();
        this.modalOpen = false;
    }

    /// <summary>🪟 G5 — modal Cancel: discard buffered edits and close~.</summary>
    private void CancelModal()
    {
        this.Reset();
        this.modalOpen = false;
    }

    // ─── 🛡️ G9 — SQL parameter builder ─────────────────────────────────────────

    /// <summary>The node's verbatim-SQL property name, or null when not a SQL node~ 🔍.</summary>
    private string? SqlPropertyName => SqlParams.FindSqlProperty(this.SelectedNode?.Schema);

    private JsonElement? BufferedParameters
        => this.buffer.TryGetValue(SqlParams.ParametersProperty, out var v) ? v : null;

    private void OpenSqlParams()
    {
        this.sqlParamName = null;
        this.sqlParamValue = null;
        this.sqlParamsOpen = true;
    }

    /// <summary>Adds the parameter to the buffered map and appends its placeholder to the SQL~ 🧷.</summary>
    private void AddSqlParam()
    {
        var name = SqlParams.SanitizeName(this.sqlParamName);
        if (name is null || this.SqlPropertyName is not { } sqlProp)
        {
            return;
        }

        this.buffer[SqlParams.ParametersProperty] = SqlParams.Upsert(this.BufferedParameters, name, this.sqlParamValue ?? string.Empty);
        this.InsertSqlPlaceholder(name);
        this.sqlParamName = null;
        this.sqlParamValue = null;
    }

    private void InsertSqlPlaceholder(string name)
    {
        if (this.SqlPropertyName is not { } sqlProp)
        {
            return;
        }

        var sql = this.buffer.TryGetValue(sqlProp, out var v) ? JsonValues.ToText(v) : string.Empty;
        var placeholder = SqlParams.Placeholder(name);
        if (!sql.Contains(placeholder, StringComparison.Ordinal))
        {
            this.buffer[sqlProp] = JsonValues.FromString(string.IsNullOrEmpty(sql) ? placeholder : sql + " " + placeholder);
        }
    }

    private void RemoveSqlParam(string name)
        => this.buffer[SqlParams.ParametersProperty] = SqlParams.Remove(this.BufferedParameters, name);

    /// <summary>🔗 Fills the value with a binding token (and suggests a name from it)~.</summary>
    private void OnSqlParamBindSource(ChangeEventArgs e)
    {
        var token = e.Value?.ToString();
        if (string.IsNullOrEmpty(token))
        {
            return;
        }

        this.sqlParamValue = token;
        if (string.IsNullOrWhiteSpace(this.sqlParamName))
        {
            // {{Variable.customerId}} → customerId; {{http-1.body}} → body.
            var inner = ExpressionBuilder.InnerOf(token);
            var lastDot = inner.LastIndexOf('.');
            this.sqlParamName = SqlParams.SanitizeName(lastDot >= 0 ? inner[(lastDot + 1)..] : inner);
        }
    }

    private void ApplyConnection()
    {
        var conn = this.SelectedConnection;
        if (conn is null)
        {
            return;
        }

        var after = string.IsNullOrWhiteSpace(this.connCondition) ? null : this.connCondition.Trim();
        if (after != conn.Condition)
        {
            this.Commands.Execute(new EditConnectionCommand(conn.Key, conn.Condition, after));
        }
    }

    private void DeleteConnection()
    {
        var conn = this.SelectedConnection;
        if (conn is null)
        {
            return;
        }

        this.Commands.Execute(new RemoveConnectionsCommand(new[] { conn.Key }));
        this.Selection.Prune(this.Document);
    }

    private void ApplyWorkflowMeta()
    {
        var tags = new List<string>();
        foreach (var t in this.wfTags.Split(',', System.StringSplitOptions.RemoveEmptyEntries | System.StringSplitOptions.TrimEntries))
        {
            tags.Add(t);
        }

        var before = (this.Document.Name, this.Document.Description, new List<string>(this.Document.Tags));
        var after = (this.wfName, this.wfDescription, tags);
        this.Commands.Execute(new EditWorkflowMetaCommand(before, after));
    }
}
