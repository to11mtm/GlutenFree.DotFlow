@namespace Workflow.UI.Client.Execution.Components
@using System.Text.Json
@using Workflow.UI.Client.Api.Dtos

@* 🔎 Phase 3.5.3 — The node list + a selected node's inputs/outputs/error (from persisted records or
   synthesized from live run state). *@
<div class="df-nodeinspect">
    <div class="df-nodeinspect__list" data-testid="node-list">
        @if (Nodes.Count == 0)
        {
            <div class="df-empty" data-testid="nodes-empty">No node records.</div>
        }
        @for (var i = 0; i < Nodes.Count; i++)
        {
            var row = i;
            var node = Nodes[row];
            @* A node has a row per run: per loop iteration / branch and per retry attempt. *@
            <button type="button" class="df-nodeinspect__node @(row == SelectedRow ? "df-nodeinspect__node--active" : "")"
                    data-testid="node-@node.NodeId" data-row="@row" @onclick="() => Select(row)">
                <span>@IconFor(node.State)</span>
                <span class="df-nodeinspect__name" title="@node.SkipReason">@node.NodeId</span>
                @if (node.ScopePath is { } path)
                {
                    @* the whole path: in nested loops the innermost #n alone repeats *@
                    <span class="df-nodeinspect__loop" data-testid="node-scope">@ShortScope(path)</span>
                }
                else if (node.LoopIteration is { } it)
                {
                    <span class="df-nodeinspect__loop">#@it</span>
                }
                @if (IsRetried(row))
                {
                    <span class="df-nodeinspect__retried" data-testid="node-retried" title="This attempt failed and the node was retried">↻ retried</span>
                }
                <span class="df-nodeinspect__dur">@Duration(node)</span>
            </button>
        }
    </div>

    @if (Current is { } sel)
    {
        <div class="df-nodeinspect__detail" data-testid="node-detail">
            <div class="df-nodeinspect__head">
                <strong>@sel.NodeId</strong> · @IconFor(sel.State) @sel.State · @Duration(sel)
                @if (sel.ScopePath is { } selPath)
                {
                    <span class="df-nodeinspect__loop" data-testid="node-detail-scope">in @selPath.Replace("/", " › ")</span>
                }
                else if (sel.LoopId is not null)
                {
                    <span class="df-nodeinspect__loop">loop @sel.LoopId #@sel.LoopIteration</span>
                }
            </div>
            <div class="df-nodeinspect__io">
                <div>
                    <div class="df-nodeinspect__label">inputs</div>
                    <pre class="df-nodeinspect__json" data-testid="node-inputs">@Pretty(sel.Inputs)</pre>
                </div>
                <div>
                    <div class="df-nodeinspect__label">outputs</div>
                    <pre class="df-nodeinspect__json" data-testid="node-outputs">@Pretty(sel.Outputs)</pre>
                </div>
            </div>
            @if (sel.SkipReason is not null)
            {
                @* 🧯 Stage 7.8 — why a stage was skipped (e.g. an earlier stage of its streaming region failed) *@
                <div class="df-nodeinspect__skip" data-testid="node-skip-reason">⏭ @sel.SkipReason</div>
            }
            @if (sel.Error is not null)
            {
                <div class="df-nodeinspect__error" data-testid="node-error">
                    <div class="df-nodeinspect__label">error</div>
                    @sel.Error
                </div>
            }
        </div>
    }
</div>

@code {
    private int? selectedRow;

    /// <summary>The node records to render.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<NodeExecutionRecordDto> Nodes { get; set; } = System.Array.Empty<NodeExecutionRecordDto>();

    /// <summary>Raised when a node's row is selected, with its node id (for the parent, e.g. replay sync).</summary>
    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    private int SelectedRow => this.selectedRow is { } r && r < this.Nodes.Count ? r : 0;

    private NodeExecutionRecordDto? Current => this.Nodes.Count == 0 ? null : this.Nodes[this.SelectedRow];

    private Task Select(int row)
    {
        this.selectedRow = row;
        var nodeId = this.Nodes[row].NodeId;
        return this.OnSelect.HasDelegate ? this.OnSelect.InvokeAsync(nodeId) : Task.CompletedTask;
    }

    /// <summary>The row badge: the iteration/branch part of each step (<c>outer#2/inner#1</c> → <c>#2 › #1</c>).</summary>
    private static string ShortScope(string path)
        => string.Join(" › ", path.Split('/').Select(step =>
        {
            var at = step.IndexOfAny(new[] { '#', '[', ':', '!' });
            return at > 0 ? step[at..] : step;
        }));

    /// <summary>A failed run with a later run of the same node in the same loop iteration was retried.</summary>
    private bool IsRetried(int row)
    {
        var node = this.Nodes[row];
        if (node.State != "Failed")
        {
            return false;
        }

        for (var later = row + 1; later < this.Nodes.Count; later++)
        {
            var other = this.Nodes[later];
            // Same node in the same run of its constructs (the scope path, when there is one, also
            // tells outer iterations and parallel branches apart)~
            if (other.NodeId == node.NodeId && other.ScopePath == node.ScopePath
                && other.LoopId == node.LoopId && other.LoopIteration == node.LoopIteration)
            {
                return true;
            }
        }

        return false;
    }

    private static string Duration(NodeExecutionRecordDto n)
        => n.DurationMs > 0 ? (n.DurationMs >= 1000 ? $"{n.DurationMs / 1000:F1}s" : $"{n.DurationMs:F0}ms") : "—";

    private static string Pretty(Dictionary<string, JsonElement>? map)
    {
        if (map is null || map.Count == 0)
        {
            return "(none)";
        }

        try
        {
            return JsonSerializer.Serialize(map, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return "(unserializable)";
        }
    }

    private static string IconFor(string state) => state switch
    {
        "Completed" => "✅",
        "Failed" => "❌",
        "Running" => "🔄",
        "Skipped" => "⏭",
        _ => "⬜",
    };
}
