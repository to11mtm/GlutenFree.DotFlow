@namespace Workflow.UI.Client.Settings.Components
@using System.Text.Json
@using Workflow.UI.Client.Api
@using Workflow.UI.Client.Api.Dtos
@using Workflow.UI.Client.Designer.State
@inject VariablesClient Variables
@inject Workflow.UI.Client.Services.ToastService Toasts

@* 🌍 Phase 3.5 (V9) — the write surface for global variables. The designer deliberately shows
   them read-only (Q7); changing a value every workflow can see is an environment action, so it
   lives here and requires the Admin role. *@
<div class="df-card df-field" data-testid="gv-panel">
    <div class="df-vars__title">
        🌍 Global variables
        <span class="df-vars__spacer"></span>
        <button class="df-btn df-btn--small" data-testid="gv-add" disabled="@adminOnly" @onclick="BeginAdd">➕ Variable</button>
    </div>

    <div class="df-field-help" data-testid="gv-warning">@VariableTokens.GlobalsCredentialWarning</div>

    @if (adminOnly)
    {
        <div class="df-field-error" data-testid="gv-admin-only">
            🔐 Changing global variables requires the Admin role. You can view them, but not edit them.
        </div>
    }

    @if (loadError is not null)
    {
        <div class="df-field-error" data-testid="gv-load-error">@loadError</div>
    }
    else if (loading)
    {
        <div class="df-empty">Loading…</div>
    }
    else if (variables.Count == 0)
    {
        <div class="df-empty" data-testid="gv-empty">No global variables yet.</div>
    }
    else
    {
        @foreach (var (name, value) in variables.OrderBy(v => v.Key, StringComparer.OrdinalIgnoreCase))
        {
            <div class="df-vars__row" data-testid="gv-row-@name">
                <div class="df-vars__head">
                    <strong>@name</strong>
                    <span class="df-vars__spacer"></span>
                    <button class="df-btn df-btn--small" data-testid="gv-history-@name"
                            title="Show every stored version" @onclick="() => ShowHistory(name)">🕘</button>
                    <button class="df-btn df-btn--small" data-testid="gv-edit-@name" disabled="@adminOnly"
                            title="Edit this value" @onclick="() => BeginEdit(name, value)">✏️</button>
                    <button class="df-btn df-btn--small df-btn--danger" data-testid="gv-delete-@name" disabled="@adminOnly"
                            title="Delete this variable and all its history" @onclick="() => Delete(name)">✕</button>
                </div>
                @if (details.GetValueOrDefault(name) is { IsSecret: true } secret)
                {
                    @* 🔒 Plan 08 — write-only: never the value, only that it's set, by whom and when *@
                    <div class="df-vars__default" data-testid="gv-secret-@name">
                        🔒 secret@(secret.SecretMode == "FollowWorkflows" ? " (follows workflow declarations)" : string.Empty)
                        @if (secret.LastSetBy is not null)
                        {
                            <span> · set by @secret.LastSetBy · @secret.LastSetAt?.ToString("u")</span>
                        }
                    </div>
                }
                else
                {
                    <div class="df-vars__default">= @value.GetRawText()</div>
                    @if (details.GetValueOrDefault(name) is { SecretMode: "FollowWorkflows" })
                    {
                        <div class="df-field-help" data-testid="gv-follow-@name">
                            ⚠ Follows workflow declarations: becomes secret (encrypted, earlier values erased) as soon as a workflow declares '@name' secret.
                        </div>
                    }
                }
                @if (historyFor == name)
                {
                    <div class="df-token-list" data-testid="gv-history-list">
                        @foreach (var entry in history)
                        {
                            <div class="df-field-help">
                                @if (entry.Change is not null)
                                {
                                    <span>@entry.UpdatedAt.ToString("u") · @entry.LastSetBy · @entry.Change</span>
                                }
                                else
                                {
                                    <span>@($"v{entry.Version} · {entry.UpdatedAt:u} · {entry.Value?.GetRawText() ?? "null"}")</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }

    @if (editing)
    {
        <div class="df-vars__form" data-testid="gv-form">
            <div class="df-field">
                <label class="df-label">Name</label>
                <input class="df-input" data-testid="gv-name" readonly="@(editingName is not null)"
                       value="@formName" @oninput="e => formName = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="df-field">
                <label class="df-label">Secret</label>
                <select class="df-input" data-testid="gv-mode" value="@formMode" @onchange="OnModeChanged">
                    <option value="None">Not secret: stored and shown as is</option>
                    <option value="Secret">Secret: encrypted, never shown again</option>
                    <option value="FollowWorkflows">Follow workflow declarations</option>
                </select>
                <div class="df-field-help" data-testid="gv-mode-help">@ModeHelp(formMode)</div>
            </div>
            <div class="df-field">
                <label class="df-label">Value (JSON)</label>
                <textarea class="df-textarea" data-testid="gv-value" spellcheck="false"
                          placeholder="@(EditingSecret ? "Enter a new value: the current one can't be shown" : string.Empty)"
                          value="@formValue" @oninput="e => formValue = e.Value?.ToString()"></textarea>
                <div class="df-field-help">
                    A JSON value — <code>"text"</code>, <code>42</code>, <code>true</code>, or an object.
                </div>
            </div>
            @if (formError is not null)
            {
                <div class="df-field-error" data-testid="gv-error">@formError</div>
            }
            <div class="df-row">
                <button class="df-btn df-btn--primary" data-testid="gv-save" @onclick="Save">Save</button>
                <button class="df-btn" data-testid="gv-cancel" @onclick="() => editing = false">Cancel</button>
            </div>
        </div>
    }

    @if (pendingPurge is { } purge)
    {
        @* 🔒 Plan 08 — marking a variable secret erases its earlier values: ask first *@
        <div class="df-modal-backdrop">
            <div class="df-modal" data-testid="gv-purge-confirm">
                <div class="df-label">Erase earlier values of '@purge.Name'?</div>
                <p>@purge.Detail</p>
                <p class="df-field-help">The current value is kept, encrypted. Earlier values can't be recovered.</p>
                <div class="df-row">
                    <button class="df-btn df-btn--danger" data-testid="gv-purge-yes" @onclick="ConfirmPurge">Erase and mark secret</button>
                    <button class="df-btn" data-testid="gv-purge-no" @onclick="() => pendingPurge = null">Cancel</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly Dictionary<string, JsonElement> variables = new(StringComparer.Ordinal);

    // 🔒 Plan 08 — each variable's secret mode / who-when, and a mode change awaiting confirmation~
    private readonly Dictionary<string, VariableDto> details = new(StringComparer.Ordinal);
    private string formMode = "None";
    private PendingPurge? pendingPurge;

    private sealed record PendingPurge(string Name, string Mode, JsonElement? Value, string Detail);

    private void OnModeChanged(ChangeEventArgs e) => this.formMode = e.Value?.ToString() ?? "None";

    private bool EditingSecret => this.editingName is not null && this.details.GetValueOrDefault(this.editingName) is { IsSecret: true };

    private static string ModeHelp(string mode) => mode switch
    {
        "Secret" => "Stored encrypted and write-only: nobody can read it back, only replace it. Its earlier values are erased (you'll be asked to confirm).",
        "FollowWorkflows" => "⚠ Becomes secret as soon as any workflow declares a variable with this name secret, which can happen when someone edits a workflow. Once secret it stays secret.",
        _ => "Stored in plain text and readable by anyone who can view variables, with its earlier values.",
    };
    private List<VariableDto> history = new();

    private bool loading = true;
    private string? loadError;
    private bool adminOnly;

    private bool editing;
    private string? editingName;
    private string formName = string.Empty;
    private string? formValue;
    private string? formError;
    private string? historyFor;

    protected override Task OnInitializedAsync() => this.Reload();

    private async Task Reload()
    {
        this.loading = true;
        this.loadError = null;
        try
        {
            var all = await Variables.ListAsync();
            this.variables.Clear();
            this.details.Clear();
            foreach (var (name, value) in all)
            {
                this.variables[name] = value;
            }

            // 🔒 Plan 08 — the secret mode and who/when come with each variable's details~
            foreach (var name in this.variables.Keys.ToList())
            {
                try
                {
                    if (await Variables.GetAsync(name) is { } detail)
                    {
                        this.details[name] = detail;
                    }
                }
                catch (Exception)
                {
                    // best effort: the row still shows~
                }
            }
        }
        catch (ApiException ex)
        {
            this.loadError = ex.Error.StatusCode is 401 or 403
                ? "You don't have permission to view global variables."
                : ex.Error.Summarize();
        }
        catch (Exception)
        {
            this.loadError = "The variables service is unavailable.";
        }
        finally
        {
            this.loading = false;
        }
    }

    private void BeginAdd()
    {
        this.editing = true;
        this.editingName = null;
        this.formName = string.Empty;
        this.formValue = null;
        this.formError = null;
        this.formMode = "None";
    }

    private void BeginEdit(string name, JsonElement value)
    {
        this.editing = true;
        this.editingName = name;
        this.formName = name;
        this.formError = null;
        var detail = this.details.GetValueOrDefault(name);
        this.formMode = detail?.SecretMode ?? "None";
        this.formValue = detail is { IsSecret: true } ? null : value.GetRawText();
    }

    private async Task Save()
    {
        var name = this.formName.Trim();
        if (!WorkflowVariables.IsValidName(name))
        {
            this.formError = "Use a letter or underscore first, then letters, numbers, underscores or dots.";
            return;
        }

        JsonElement? element = null;
        if (!string.IsNullOrWhiteSpace(this.formValue))
        {
            if (JsonValues.TryParseJson(this.formValue) is not { } parsed)
            {
                this.formError = "The value isn't valid JSON.";
                return;
            }

            element = parsed;
        }

        var currentMode = this.editingName is not null ? this.details.GetValueOrDefault(name)?.SecretMode ?? "None" : "None";
        if (element is null && (this.formMode == currentMode || this.editingName is null) && !this.EditingSecret)
        {
            this.formError = "The value isn't valid JSON.";
            return;
        }

        try
        {
            if (this.formMode != currentMode)
            {
                await this.ChangeMode(name, this.formMode, element, confirmPurge: false);
                return;
            }

            if (element is not null)
            {
                await Variables.SetAsync(name, element);
            }

            this.editing = false;
            Toasts.Success($"Saved '{name}'");
            await this.Reload();
        }
        catch (ApiException ex)
        {
            this.HandleWriteFailure(ex);
        }
    }

    /// <summary>🔒 Plan 08 — changes the mode; if that would erase earlier values, asks first.</summary>
    private async Task ChangeMode(string name, string mode, JsonElement? value, bool confirmPurge)
    {
        try
        {
            await Variables.SetSecretModeAsync(name, mode, value, confirmPurge);
            this.pendingPurge = null;
            this.editing = false;
            Toasts.Success($"Saved '{name}'");
            await this.Reload();
        }
        catch (ApiException ex) when (ex.Error.StatusCode == 409)
        {
            this.pendingPurge = new PendingPurge(name, mode, value, ex.Error.Detail ?? ex.Error.Summarize());
        }
    }

    private async Task ConfirmPurge()
    {
        if (this.pendingPurge is not { } purge)
        {
            return;
        }

        try
        {
            await this.ChangeMode(purge.Name, purge.Mode, purge.Value, confirmPurge: true);
        }
        catch (ApiException ex)
        {
            this.pendingPurge = null;
            this.HandleWriteFailure(ex);
        }
    }

    private async Task Delete(string name)
    {
        try
        {
            await Variables.DeleteAsync(name);
            Toasts.Info($"Deleted '{name}'");
            await this.Reload();
        }
        catch (ApiException ex)
        {
            this.HandleWriteFailure(ex);
        }
    }

    private async Task ShowHistory(string name)
    {
        if (this.historyFor == name)
        {
            this.historyFor = null;
            return;
        }

        try
        {
            this.history = await Variables.HistoryAsync(name);
            this.historyFor = name;
        }
        catch (ApiException ex)
        {
            Toasts.Error(ex.Error.Summarize());
        }
    }

    /// <summary>
    /// V9.3 — react to the server's answer rather than guessing at roles client-side.
    /// <c>AuthState</c> only knows whether a credential exists, not what it can do, so a 403 is the
    /// authoritative signal that this credential can read globals but not change them.
    /// </summary>
    private void HandleWriteFailure(ApiException ex)
    {
        if (ex.Error.StatusCode == 403)
        {
            this.adminOnly = true;
            this.editing = false;
            return;
        }

        this.formError = ex.Error.Summarize();
    }
}
